    const newHistorico = await pool.query('SELECT historico FROM pedidos WHERE id = $1', [pid]);
    if (!newHistorico.rowCount) return send(res, 404, { error: 'pedido não existe' });
    const historico = [...(newHistorico.rows[0].historico || []), { status, timestamp: now }];
    let updateSql = 'UPDATE pedidos SET status = $1, updated_at = $2, historico = $3';
    const params = [status, now, JSON.stringify(historico)];
    if (validSubStatuses.includes(body.subStatus)) {
      updateSql += ', sub_status = $4 WHERE id = $5';
      params.push(body.subStatus, pid);
    } else if (body.subStatus === null || status === 'entregue' || status === 'cancelado') {
      updateSql += ', sub_status = NULL WHERE id = $4';
      params.push(pid);
    } else {
      updateSql += ' WHERE id = $4';
      params.push(pid);
    }
    if (status === 'entregue' && Array.isArray(body.formasPagamento)) {
      // need to handle param index shift — for simplicity, use two separate updates
      await pool.query(updateSql, params);
      await pool.query('UPDATE pedidos SET formas_pagamento = $1 WHERE id = $2', [JSON.stringify(body.formasPagamento), pid]);
    } else {
      await pool.query(updateSql, params);
    }
    return send(res, 204, '');

