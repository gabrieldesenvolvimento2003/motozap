   - Indexes: idx_lojas_motoboy, idx_pedidos_motoboy, idx_pedidos_loja, idx_pedidos_created

2. db.js — Node pg pool helper:
\`\`\`
const { Pool } = require('pg');
const fs = require('fs');
const path = require('path');

const pool = new Pool({
  connectionString: process.env.DATABASE_URL,
  ssl: { rejectUnauthorized: false },
  max: 5,
});

async function migrate() {
  const sql = fs.readFileSync(path.join(__dirname, 'schema.sql'), 'utf8');
  await pool.query(sql);
}

module.exports = { pool, migrate };
\`\`\`

IMPORTANT: do NOT touch sync.js yet — only create the 2 files.`,
  { label: 'create schema+db helper', phase: 'Write schema + db helper' }
);

